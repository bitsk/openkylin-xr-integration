+func _poll_home_recenter() -> void:
+	var now := Time.get_ticks_msec()
+	if now < _home_recenter_poll_msec:
+		return
+	_home_recenter_poll_msec = now + 50
+	if not FileAccess.file_exists(_home_recenter_path):
+		return
