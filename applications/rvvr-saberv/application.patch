+	var eye_target := Vector3(0.0, floor_y + MIX_EYE_HEIGHT_METERS, 1.0)
+	xr_origin.global_position += eye_target - xr_origin.to_global(head_transform.origin)
+	_mix_origin_y = xr_origin.position.y
+	xr_origin.position.y += Settings.player_height_offset
+	_mix_recenter_pending = false
+
+	print("SABERV_FLOOR_CALIBRATION ", JSON.stringify({
+		"stage": vr.xr_interface.get_play_area_mode() == XRInterface.XR_PLAY_AREA_STAGE,
+		"source": _mix_recenter_source,
+		"stage_eye_y_m": pose.transform.origin.y,
+		"floor_y_m": floor_y,
+		"eye_height_m": xr_origin.to_global(head_transform.origin).y - floor_y,
+		"manual_offset_m": Settings.player_height_offset
+	}))
