#!/usr/bin/python3
"""Guard staged VR700 remoteproc startup and the one resident SDSP listener."""
import os
import sys
import time
from pathlib import Path


def start_processor(name, entry):
    state_file = entry / 'state'
    for attempt in range(1, 4):
        state = state_file.read_text().strip()
        if state == 'running':
            return
        if state != 'offline':
            raise RuntimeError(name + ': unexpected state ' + state)
        error = None
        try:
            state_file.write_text('start\n')
        except OSError as exc:
            error = exc
            print(f'{name}: start attempt {attempt}/3 failed: {exc}', file=sys.stderr, flush=True)
        state = state_file.read_text().strip()
        if state == 'running':
            return
        if state != 'offline':
            raise RuntimeError(name + ': unexpected state after start: ' + state) from error
        if error is None:
            print(f'{name}: start attempt {attempt}/3 left processor offline', file=sys.stderr, flush=True)
        if attempt == 3:
            raise RuntimeError(name + ': still offline after three start attempts') from error
        # Retry only the unchanged offline state, never reset a running DSP.
        # ENOMEM is not evidence of readiness or of a fixed startup delay.
        print(name + ': retrying offline processor in 2 seconds', file=sys.stderr, flush=True)
        time.sleep(2)


def wait_sdsp_node(entry):
    deadline = time.monotonic() + 10
    node = Path('/dev/fastrpc-sdsp')
    print('Waiting for SLPI FastRPC character device', flush=True)
    while True:
        state = (entry / 'state').read_text().strip()
        if state != 'running':
            raise RuntimeError('SLPI stopped while waiting for FastRPC device: ' + state)
        if node.is_char_device():
            print('SLPI FastRPC character device ready', flush=True)
            return
        if time.monotonic() >= deadline:
            raise RuntimeError('SLPI FastRPC character device not ready within 10s')
        # The remoteproc running state can precede FastRPC device creation.
        # Let After=vr700-slpi.service depend on the actual node, not a delay.
        time.sleep(0.1)


def processors_for_board():
    if os.geteuid() != 0:
        raise RuntimeError('root is required')
    if Path('/etc/xr-rootfs-id').read_text().strip() != 'vr700-openkylin-3.0-arm64':
        raise RuntimeError('not the VR700 installed root')
    if b'iqiyi,vr700' not in Path('/sys/firmware/devicetree/base/compatible').read_bytes().split(b'\0'):
        raise RuntimeError('not the VR700 board')
    root = Path('/usr/lib/firmware/xr/vr700')
    if Path('/sys/module/firmware_class/parameters/path').read_text().strip() != str(root):
        raise RuntimeError('VR700 firmware_class.path is not selected')
    processors = {}
    for entry in Path('/sys/class/remoteproc').glob('remoteproc*'):
        name = (entry / 'name').read_text().strip()
        if name in ('slpi', 'cdsp'):
            if name in processors:
                raise RuntimeError('ambiguous remote processor: ' + name)
            processors[name] = entry
    if set(processors) != {'slpi', 'cdsp'}:
        raise RuntimeError('SLPI and CDSP must both be registered')
    # Validate both selections before starting either remote processor.
    for name, entry in processors.items():
        firmware = 'qcom/sm8250/iqiyi/vr700/' + name + '.mdt'
        if (entry / 'firmware').read_text().strip() != firmware:
            raise RuntimeError('unexpected firmware selection: ' + name)
        if not (root / firmware).is_file():
            raise RuntimeError('missing firmware: ' + firmware)
        if (entry / 'state').read_text().strip() not in ('offline', 'running'):
            raise RuntimeError('remote processor is not available: ' + name)
    return processors


def sdsp_owners():
    owners = []
    for process in Path('/proc').iterdir():
        if not process.name.isdecimal():
            continue
        try:
            held = False
            for fd in (process / 'fd').iterdir():
                try:
                    held |= str(fd.readlink()) in ('/dev/fastrpc-sdsp', '/dev/fastrpc-sdsp-secure')
                except FileNotFoundError:
                    pass
            if held:
                argv = (process / 'cmdline').read_bytes().rstrip(b'\0').decode().split('\0')
                groups = [line.split(':', 2)[2] for line in (process / 'cgroup').read_text().splitlines()]
                owners.append((process.name, argv, groups))
        except (FileNotFoundError, ProcessLookupError):
            continue
    return owners


def wait_sensors(processors):
    deadline = time.monotonic() + 45
    previous = None
    while True:
        state = (processors['slpi'] / 'state').read_text().strip()
        if state != 'running':
            raise RuntimeError('SLPI stopped during registry readiness: ' + state)
        owners = sdsp_owners()
        if len(owners) > 1:
            raise RuntimeError('multiple SDSP owners; refusing CDSP startup: ' + str(owners))
        if owners:
            pid, argv, groups = owners[0]
            pairs = list(zip(argv, argv[1:]))
            if (not argv or Path(argv[0]).name != 'xr-hexagonrpcd' or '-s' not in argv or
                    ('-f', '/dev/fastrpc-sdsp') not in pairs or
                    ('-R', '/usr/share/qcom/sm8250/iqiyi/vr700') not in pairs or
                    not any(g.endswith('/vr700-sensors-files.service') for g in groups)):
                raise RuntimeError('SDSP owner is not the formal sensor service: ' + str(owners))
        sensors = set()
        for name in Path('/sys/bus/iio/devices').glob('iio:device*/name'):
            try:
                sensors.add(name.read_text().strip())
            except FileNotFoundError:
                pass
        needed = {'qcom-see-accel', 'qcom-see-gyro'}
        if owners and needed <= sensors:
            print('SLPI registry readiness: formal SDSP owner and SEE accel/gyro registered', flush=True)
            return
        observation = (tuple(owner[0] for owner in owners), tuple(sorted(needed - sensors)))
        if observation != previous:
            print('Waiting for SLPI registry: owners=' + str(observation[0]) +
                  ' missing_sensors=' + str(observation[1]), flush=True)
            previous = observation
        if time.monotonic() >= deadline:
            raise RuntimeError('SLPI registry not ready within45s: ' + str(observation))
        # Poll actual owner/sensor state; elapsed time alone never means ready.
        time.sleep(0.2)


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ('slpi', 'cdsp', 'verify', 'check-sdsp-free', 'wait-sensors'):
        raise RuntimeError('usage: vr700-start-dsp slpi|cdsp|verify|check-sdsp-free|wait-sensors')
    processors = processors_for_board()
    phase = sys.argv[1]
    if phase == 'check-sdsp-free':
        owners = sdsp_owners()
        if owners:
            raise RuntimeError('SDSP already owned; refusing a duplicate resident: ' + str(owners))
        return
    if phase in ('wait-sensors', 'cdsp'):
        wait_sensors(processors)
        if phase == 'wait-sensors':
            return
    if phase == 'verify':
        for name, entry in processors.items():
            if (entry / 'state').read_text().strip() != 'running':
                raise RuntimeError(name + ': not running at startup completion')
        print('SLPI and CDSP running; sensor/pose acceptance is separate', flush=True)
        return
    start_processor(phase, processors[phase])
    if phase == 'slpi':
        wait_sdsp_node(processors[phase])
    print(phase + ': running', flush=True)


if __name__ == '__main__':
    main()
