[Unit]
Description=VR700 SLPI sensor registry and runtime files
After=local-fs.target vr700-slpi.service
Requires=vr700-slpi.service
ConditionPathExists=/dev/fastrpc-sdsp
ConditionPathIsDirectory=/usr/share/qcom/sm8250/iqiyi/vr700
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=exec
ExecStartPre=/usr/libexec/vr700-start-dsp check-sdsp-free
ExecStartPre=/usr/sbin/modprobe qcom-see
ExecStart=/usr/bin/xr-hexagonrpcd -f /dev/fastrpc-sdsp -s -R /usr/share/qcom/sm8250/iqiyi/vr700
ExecStartPost=/usr/libexec/vr700-start-dsp wait-sensors
TimeoutStartSec=60
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
