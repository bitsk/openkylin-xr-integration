[Unit]
Description=Verify VR700 SLPI and CDSP startup
Requires=vr700-slpi.service vr700-cdsp.service
After=vr700-slpi.service vr700-cdsp.service
ConditionPathExists=/etc/xr-rootfs-id

[Service]
Type=oneshot
ExecStart=/usr/libexec/vr700-start-dsp verify
TimeoutStartSec=15
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
